# Career Uttsav Partner Portal — copy to .env.local
# This app always runs on http://localhost:3001 (see package.json scripts).

# Public URL used in password-reset emails (optional; defaults to :3001)
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Admin app that issues partner Chapter 8 credentials (required for login).
# Must be a different port than this portal (3001).
ADMIN_API_URL=http://localhost:3000
