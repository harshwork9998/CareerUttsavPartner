# Career Uttsav Partner Portal — copy to .env.local

# Local
ADMIN_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Shared server-to-server secret for Partner Portal → Admin API calls.
# Server-side only — do NOT use a NEXT_PUBLIC_ prefix.
# Must match PARTNER_PORTAL_SERVICE_SECRET in CareerUttsavAdmin/.env.local.
PARTNER_PORTAL_SERVICE_SECRET=

# Required for signing partner session cookies (HMAC-SHA256).
# Server-side only — do NOT use a NEXT_PUBLIC_ prefix.
# Use a long random secret. Keep the same value across deployments;
# changing it invalidates all existing partner sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase publishable key — browser TUS uploads to private Storage only (NOT sb_secret_)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy JWT fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY

# Production (set these on the partners.careeruttsav.in host)
# ADMIN_API_URL=https://admin.careeruttsav.in
# NEXT_PUBLIC_APP_URL=https://partners.careeruttsav.in
# SESSION_SECRET=replace-with-a-long-random-secret
