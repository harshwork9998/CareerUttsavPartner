# Career Uttsav Partner Portal — copy to .env.local

# Local
ADMIN_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Required for signing partner session cookies (HMAC-SHA256).
# Server-side only — do NOT use a NEXT_PUBLIC_ prefix.
# Use a long random secret. Keep the same value across deployments;
# changing it invalidates all existing partner sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Production (set these on the partners.careeruttsav.in host)
# ADMIN_API_URL=https://admin.careeruttsav.in
# NEXT_PUBLIC_APP_URL=https://partners.careeruttsav.in
# SESSION_SECRET=replace-with-a-long-random-secret
